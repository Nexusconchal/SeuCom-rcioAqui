# Defina uma chave aleatória longa antes de usar em produção.
SECRET_KEY=
APP_ENV=development
DATABASE_PATH=instance/seucomercio.sqlite3
UPLOAD_DIR=instance/uploads
PORT=8000
# Produção: URL HTTPS, cookies seguros e os hosts que você usa.
PUBLIC_URL=http://localhost:8000
TRUSTED_HOSTS=localhost,127.0.0.1
TRUST_PROXY=0
ALLOW_REGISTRATION=1

# PostgreSQL remoto: use o pooler de sessão do Supabase (IPv4, porta 5432).
# Não coloque estas credenciais no GitHub nem no frontend.
DATABASE_URL=
DATABASE_SCHEMA=seucomercio
# Storage remoto. Deixe vazio somente no desenvolvimento local.
STORAGE_UPLOAD_URL=
STORAGE_UPLOAD_TOKEN=
STORAGE_PUBLIC_URL=
