# Defina uma chave aleatória longa antes de usar em produção.
SECRET_KEY=
APP_ENV=development
DATABASE_PATH=instance/seucomercio.sqlite3
UPLOAD_DIR=instance/uploads
PORT=8000
# Produção: URL HTTPS, cookies seguros e os hosts que você usa.
PUBLIC_URL=http://localhost:8000
TRUSTED_HOSTS=localhost,127.0.0.1
TRUST_PROXY=0
ALLOW_REGISTRATION=1

# PostgreSQL remoto: use o pooler de sessão do Supabase (IPv4, porta 5432).
# Não coloque estas credenciais no GitHub nem no frontend.
DATABASE_URL=
DATABASE_SCHEMA=seucomercio
# Storage remoto. Deixe vazio somente no desenvolvimento local.
STORAGE_UPLOAD_URL=
STORAGE_UPLOAD_TOKEN=
STORAGE_PUBLIC_URL=

# Evolution no servidor; depois conecte cada loja.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Worker opcional: python marketing_worker.py
# Mesmo DATABASE_URL/DATABASE_SCHEMA/SECRET_KEY/PUBLIC_URL da aplicação.

# Atendimento: embedded usa o serviço web; external/off desativam o loop web.
INBOX_DISPATCH_MODE=embedded

# Consulta opcional ao catálogo: exclusivamente openrouter/free, sem fallback pago.
OPENROUTER_API_KEY=

# Recuperação de senha. No Render Free, use HTTPS (SMTP é bloqueado pelo plano).
# Ative apenas depois de verificar o remetente/domínio no serviço de e-mail.
RECOVERY_EMAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=
# Alternativa em hospedagem que permita SMTP com TLS:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
